!JadeiteComponentEditor methodsFor!

editProject: projectName
	self createView: self class defaultView.
	model := (RowanProjectDefinitionService new name: projectName) editInSession: gciSession
				window: self view handle value.
	self updateCaption.  "pick up the project definition name in the caption" 
	myPresenter model: model.
	myPresenter
		displayComponents;
		displayLoadSpecification.
	myPresenter projectDefinitionService session: self gciSession.
	^self show!

onViewClosed
	super onViewClosed.
	myPresenter onViewClosed.
	self gciSession
		ifNotNil: 
			[:sess |
			sess isValidSession
				ifTrue: [RowanBrowserService new releaseWindow: self view handle value session: self gciSession]]!

presenterClass
	^JadeiteComponentPresenter!

updateCaption
	self caption: (gciSession titleBarFor: 'Project Component Editor for ', model name)! !
