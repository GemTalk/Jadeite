!JadeiteComponentEditor categoriesForClass!Unclassified! !
!JadeiteComponentEditor methodsFor!

cancel
	^self primaryPresenter cancel!

createProject
	^self primaryPresenter createProject!

editLoadSpec
	^myPresenter editLoadSpec!

editProject: projectName
	self createView: self class defaultView.
	model := (RowanProjectDefinitionService new name: projectName) editInSession: gciSession
				window: self view handle value.
	self updateCaption.  "pick up the project definition name in the caption" 
	model session: self gciSession.
	myPresenter model: model.
	myPresenter
		displayComponents;
		displayTabs. 
	^self show!

exportProjectDefinition
	^myPresenter exportProjectDefinition!

onViewClosed
	super onViewClosed.
	myPresenter onViewClosed.
	self gciSession
		ifNotNil: [:sess | RowanBrowserService new releaseWindow: self view handle value session: self gciSession]!

presenterClass
	^JadeiteComponentPresenter!

updateCaption
	self caption: (gciSession titleBarFor: 'Load Component Editor for ', model name)! !
