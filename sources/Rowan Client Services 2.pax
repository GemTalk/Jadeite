	add: #RowanDictionaryService;
	add: #RowanFileService;
	add: #RowanFillerClassService;
	add: #RowanFrameService;
	add: #RowanInspectorService;
	add: #RowanLoadSpecService;
	add: #RowanLoggingService;
	add: #RowanMethodDefinitionService;
