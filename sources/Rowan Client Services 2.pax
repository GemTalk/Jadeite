| package |
package := Package name: 'Rowan Client Services 2'.
package paxVersion: 1;
	basicComment: ''.


package classNames
	add: #BrowserUpdate;
	add: #JadeiteTreeModel;
	add: #JadeiteTreeNode;
	add: #RowanAnsweringService;
	add: #RowanAutoCommitService;
	add: #RowanBrowserService;
