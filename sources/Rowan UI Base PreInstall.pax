| package |
package := Package name: 'Rowan UI Base PreInstall'.
package paxVersion: 1;
	basicComment: ''.

package basicScriptAt: #preinstall put: ' "custom methods will be readded in Rowan UI Base package"
ProcessorScheduler removeSelector: #userBreak:. 
Association removeSelector: #stonOn:.
Time removeSelector: #stonOn:.
Date class removeSelector: #fromSton:.
Date removeSelector: #stonOn:. 
ExternalStructure class removeSelector: #canUnderstand:.
DolphinSureCertificateStore class removeSelector: #clearTemporaryTrustStore.
SocketAbstract class removeSelector: #onShutdown.
"note - that the following 2 lines will break error dialogs during install until Rowan UI Base is loaded" 
View removeSelector: #wmWindowPosChanged:wParam:lParam:.
View removeSelector: #wmWindowPosChanging:wParam:lParam:.
DragDropSession removeSelector: #defaultScrollInterval.


'.

package classNames
	add: #JadeiteSTON;
	add: #JadeiteSTONWriter;
	yourself.

package binaryGlobalNames: (Set new
	yourself).

package globalAliases: (Set new
	yourself).

package setPrerequisites: #(
	'..\Core\Object Arts\Dolphin\System\STON\Dolphin STON'
	'..\Core\Contributions\svenc\STON\STON-Core').

package!

"Class Definitions"!

STON subclass: #JadeiteSTON
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!
DolphinSTONWriter subclass: #JadeiteSTONWriter
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	classInstanceVariableNames: ''!

"Global Aliases"!


"Loose Methods"!

"End of package definition"!

